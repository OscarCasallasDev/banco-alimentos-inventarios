# ============================================================
# VARIABLES DE ENTORNO — Sistema de Gestión de Inventarios
# Banco Arquidiocesano de Alimentos de Ibagué
# ============================================================
# Copia este archivo como .env.local y configura los valores.
# NUNCA subas el archivo .env.local al repositorio.
#
# En producción (Vercel) estas mismas variables se configuran en
# Settings → Environment Variables del proyecto, para los entornos
# Production, Preview y Development.
# Sincronización automática:  node scripts/vercel-env-sync.mjs
# ============================================================

# ---------- BASE DE DATOS (Supabase PostgreSQL) ----------
# Connection string de Supabase.
# Se obtiene en: Supabase Dashboard → Project Settings → Database → Connection string
#
# IMPORTANTE: usa el POOLER en MODO TRANSACCIÓN (puerto 6543).
#
#   El modo sesión (5432) abre una conexión del servidor por cada cliente y
#   Supabase limita el pool a 15 conexiones PARA TODO EL PROYECTO. En Vercel
#   cada instancia de función es un proceso aparte, así que una ráfaga de
#   peticiones agota el pool y provoca
#   "(EMAXCONNSESSION) max clients reached in session mode".
#   Medido en este proyecto: 12 peticiones simultáneas → 5 en error con el
#   modo sesión, 0 en error con el modo transacción.
#   El modo transacción multiplexa muchas conexiones sobre pocas del servidor,
#   que es lo que necesita un despliegue serverless.
#
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# El script `npm run db:check` prueba las variantes (directa y pooler
# en varias regiones) y deja aquí la que funciona.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Conexiones de respaldo, separadas por coma. Si la principal falla por un
# problema de red o DNS, la aplicación reintenta sola con estas.
#
# Se usa el pooler en MODO SESIÓN (5432) como red de seguridad: es estable
# y no se agota, así que sirve cuando el modo transacción falla.
DATABASE_FALLBACK_URLS="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- SUPABASE (API) ----------
# Project URL del proyecto.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Clave publicable (va al navegador, no es secreta).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[TU_CLAVE_PUBLICA]"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[TU_CLAVE_PUBLICA]"

# Clave secreta del servidor. NUNCA la expongas en el frontend ni la subas al repo.
SUPABASE_SECRET_KEY="sb_secret_[TU_CLAVE_SECRETA]"

# ---------- SEGURIDAD ----------
# Secreto de firma de las cookies de sesión (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="[CAMBIA_ESTO_POR_UN_SEGURO_RANDOM_DE_64_CARACTERES]"

# ---------- APLICACIÓN ----------
# NO definas NODE_ENV en Vercel: la plataforma lo fija en "production" y es
# lo que activa la cookie `secure` de la sesión.
# NODE_ENV="development"

# Tamaño máximo del pool de conexiones a PostgreSQL POR PROCESO.
#
# Con el pooler en modo transacción no hay el techo de 15 conexiones de
# Supabase, pero en Vercel cada instancia es un proceso aparte: un pool
# grande multiplica el consumo. 5 es un equilibrio razonable.
DATABASE_POOL_MAX="5"

# Cierre de conexiones ociosas, en segundos. En Vercel las instancias se
# congelan cuando quedan inactivas y el socket puede morir en silencio;
# cerrarlas pronto evita reutilizar una conexión "zombi".
DATABASE_IDLE_TIMEOUT="30"
