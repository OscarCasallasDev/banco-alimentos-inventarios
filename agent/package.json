{
  "name": "banco-alimentos-agente-siigo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente local de sincronización con Siigo Pyme — Banco Arquidiocesano de Alimentos de Ibagué",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "install-task": "powershell -ExecutionPolicy Bypass -File install.ps1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
